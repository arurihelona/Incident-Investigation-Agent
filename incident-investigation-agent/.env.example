# =====================================================================
# Incident Investigation Agent - Environment Configuration
# =====================================================================

# LLM Provider: "auto", "openai", "gemini", "anthropic", "local", "heuristic"
# If no API key is provided, system automatically uses the built-in deterministic engine.
LLM_PROVIDER=auto

# API Key (Optional: leave empty to run offline with zero external dependencies)
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Name
LLM_MODEL=gpt-4o-mini

# Custom Base URL (Optional, for local Ollama, vLLM, or OpenAI-compatible gateways)
LLM_BASE_URL=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# ChromaDB Storage Path
CHROMA_PERSIST_DIR=./chroma_db
DATA_PATH=./data/documents.json
